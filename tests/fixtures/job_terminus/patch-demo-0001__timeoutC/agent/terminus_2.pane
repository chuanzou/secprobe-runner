package policy

import "fmt"

func CheckRevision(g, w int) error {
	if g < 1 || g < w {
		return fmt.Errorf("policy_revision_rollback")
	}
	return nil
}
func CheckProfile(s string) error {
	if s != "standard" && s != "long_lived" {
		return fmt.Errorf("profile_unknown")
	}
	return nil
}
func RequiredTarget(s string) int {
	if s == "long_lived" {
		return 192
	}
	return 128
}
func Compatible(a, b Policy) bool {
	return a.Algorithm == b.Algorithm && a.MinKeyBits >= b.MinKeyBits && a.MinIterations >= b.MinIterations && a.MinMemory >= b.MinMemory
}
func Clamp(p Policy) Policy {
	if p.MinKeyBits < 256 {
		p.MinKeyBits = 256
	}
	if p.MinSalt < 16 {
		p.MinSalt = 16
	}
	if p.MinIterations < 12000 {
		p.MinIterations = 12000
	}
	if p.MinMemory < 64 {
		p.MinMemory = 64
	}
	if p.MinParallel < 2 {
		p.MinParallel = 2
	}
	return p
}
func Explain(p Params) []string {
	r := []string{}
	if p.Algorithm != "AES-256-GCM" {
		r = append(r, "algorithm")
	}
	if p.KeyBits < 256 {
		r = append(r, "key_bits")
	}
	if p.SaltLen < 16 {
		r = append(r, "salt")
	}
	if p.NonceLen != 12 {
		r = append(r, "nonce")
	}
	return r
}
func StrengthFloor(p Policy) int {
	v := p.MinKeyBits / 2
	if p.Target > v {
		v = p.Target
	}
	return v
}
func IsLegacy(s string) bool     { return s == "AES-CBC" || s == "3DES" || s == "ECB" }
func PolicyName(p Policy) string { return fmt.Sprintf("%s-r%d", p.Profile, p.Revision) }
}

func safeRoot(root string) (string, error) {
	if root == "" {
		return "", fmt.Errorf("invalid_root")
	}
	a, e := filepath.Abs(root)
	if e != nil {
		return "", e
	}
	return filepath.Clean(a), nil
}
func LoadVault(root string) (VaultState, error) {
	r, e := safeRoot(root)
	if e != nil {
		return VaultState{}, e
	}
	if e = os.MkdirAll(r, 0700); e != nil {
		return VaultState{}, e
	}
	b, e := os.ReadFile(filepath.Join(r, "metadata.json"))
	if os.IsNotExist(e) {
		return VaultState{Root: r, Policy: policy.Default(), Markers: map[string]string{}}, nil
	}
	if e != nil {
		return VaultState{}, e
	}
	var s VaultState
	if e = json.Unmarshal(b, &s); e != nil {
		return VaultState{}, fmt.Errorf("malformed_metadata")
	}
	if s.Markers == nil {
		s.Markers = map[string]string{}
	}
	s.Root = r
	s.Policy = policy.Clamp(s.Policy)
	return s, nil
}
func SaveVault(s VaultState) error { return Save(s) }
